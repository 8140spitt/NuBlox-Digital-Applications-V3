# NuBlox V3 — MySQL 8.0+
# Create these databases/users in MySQL before running migrations.

DATABASE_URL=mysql://nublox:change-me@127.0.0.1:3306/nublox_v3
NUBLOX_TEST_DATABASE_URL=mysql://nublox:change-me@127.0.0.1:3306/nublox_v3_test

# Clean migration tests create and drop an isolated temporary database.
# Use a local/test-only MySQL account with CREATE/DROP DATABASE and GRANT privileges.
NUBLOX_TEST_ADMIN_DATABASE_URL=mysql://root:change-me@127.0.0.1:3306/mysql

# Canonical application origin used for authentication callbacks and origin validation.
BETTER_AUTH_URL=http://localhost:5173

# Required by the production runtime. Generate a strong local value with:
# openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Public sign-up remains disabled unless explicitly enabled.
NUBLOX_ALLOW_PUBLIC_SIGNUP=false

# Set true when your MySQL endpoint requires TLS.
MYSQL_SSL=false
