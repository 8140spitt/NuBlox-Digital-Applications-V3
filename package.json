{
  "name": "nublox",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "check": "pnpm --filter @nublox/kernel build && pnpm --filter @nublox/persistence build && pnpm -r check",
    "test": "pnpm --filter @nublox/kernel build && pnpm -r --if-present test",
    "build": "pnpm -r build",
    "db:migrate": "pnpm --dir packages/persistence db:migrate",
    "db:status": "pnpm --dir packages/persistence db:status",
    "format": "pnpm --dir apps/web format",
    "format:check": "pnpm --dir apps/web format:check",
    "auth:bootstrap": "pnpm --dir packages/persistence auth:bootstrap",
    "terminal:logged": "./scripts/start-logged-terminal.sh",
    "terminal:logs": "./scripts/list-terminal-logs.sh",
    "terminal:tail": "./scripts/tail-latest-terminal-log.sh"
  }
}
