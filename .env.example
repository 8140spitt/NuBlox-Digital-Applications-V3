# NuBlox database
NUBLOX_DATABASE_URL=mysql://nublox:nublox@127.0.0.1:3306/nublox
# Set true only when the database endpoint requires TLS.
NUBLOX_DB_SSL=false

# First controlled application account bootstrap.
# Either provide an existing tenant/person pair:
# NUBLOX_BOOTSTRAP_TENANT_ID=
# NUBLOX_BOOTSTRAP_TENANT_SLUG=
# NUBLOX_BOOTSTRAP_PERSON_ID=
#
# Or omit both IDs and provide names to create the first tenant/person:
# NUBLOX_BOOTSTRAP_TENANT_NAME=NuBlox
# NUBLOX_BOOTSTRAP_PERSON_NAME=Platform Administrator
#
# NUBLOX_BOOTSTRAP_EMAIL=admin@example.com
# NUBLOX_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password

# First bootstrap normally grants the tenant-scoped Platform Administrator access role.
# This controls platform access only and does not grant business Decision Authority.
NUBLOX_BOOTSTRAP_GRANT_PLATFORM_ADMIN=true

# Public origin used to construct verification/recovery action URLs.
# Production must use HTTPS.
NUBLOX_PUBLIC_ORIGIN=http://localhost:5173

# Identity email delivery.
# Production: configure an HTTPS endpoint that accepts the NuBlox identity-message JSON envelope.
# NUBLOX_IDENTITY_EMAIL_WEBHOOK_URL=https://mail-gateway.example.com/nublox/identity
# NUBLOX_IDENTITY_EMAIL_WEBHOOK_TOKEN=replace-with-delivery-gateway-token
# NUBLOX_IDENTITY_EMAIL_BATCH_SIZE=25

# Local development automatically falls back to console delivery when no webhook is configured.
# Production never permits console delivery.
# NUBLOX_IDENTITY_EMAIL_POLL_MS=1500

# Authentication anti-abuse HMAC secret.
# Required in production; use at least 32 high-entropy characters.
# NUBLOX_AUTH_RATE_LIMIT_SECRET=replace-with-a-long-random-secret

# Authentication secret encryption key.
# Required in production. Supply exactly 32 random bytes encoded as base64url or 64 hex characters.
# Used to encrypt TOTP secrets and protect recovery-code hashes.
# NUBLOX_AUTH_ENCRYPTION_KEY=replace-with-a-32-byte-random-key

# Optional bootstrap Tenant business profile. Defaults target the current CBE development setup.
# NUBLOX_BOOTSTRAP_INDUSTRY_CLASSIFICATION_ID=BCV-NUBLOX-CBE
# NUBLOX_BOOTSTRAP_SIZE_TIER=SMALL
# NUBLOX_BOOTSTRAP_EMPLOYEE_COUNT=25
# NUBLOX_BOOTSTRAP_LEGAL_ENTITY_COUNT=1
# NUBLOX_BOOTSTRAP_COUNTRY_CODE=GB
# NUBLOX_BOOTSTRAP_LANGUAGE_CODE=en-GB
# NUBLOX_BOOTSTRAP_OPERATING_MODELS=PROJECT_BASED
