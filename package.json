{
  "name": "nublox",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check": "pnpm architecture:check && pnpm --filter @nublox/kernel build && pnpm --filter @nublox/persistence build && pnpm -r check",
    "test": "pnpm --filter @nublox/kernel build && pnpm -r --if-present test",
    "build": "pnpm -r build",
    "db:migrate": "pnpm --dir packages/persistence db:migrate",
    "db:status": "pnpm --dir packages/persistence db:status",
    "format": "pnpm --dir apps/web format",
    "format:check": "pnpm --dir apps/web format:check",
    "auth:bootstrap": "pnpm --dir packages/persistence auth:bootstrap",
    "platform:bootstrap": "pnpm --dir packages/persistence platform:bootstrap",
    "auth:dispatch-messages": "pnpm --dir packages/persistence auth:dispatch-messages",
    "auth:dispatch-loop": "pnpm --dir packages/persistence auth:dispatch-loop",
    "terminal:logged": "./scripts/start-logged-terminal.sh",
    "terminal:logs": "./scripts/list-terminal-logs.sh",
    "terminal:tail": "./scripts/tail-latest-terminal-log.sh",
    "architecture:generate": "node scripts/generate-erp-composition.mjs",
    "architecture:check": "node scripts/generate-erp-composition.mjs --check && node scripts/validate-market-tool-activities.mjs",
    "db:retry-failed": "pnpm --dir packages/persistence db:retry-failed"
  }
}
