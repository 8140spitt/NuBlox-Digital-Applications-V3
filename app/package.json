{
  "name": "nublox-v3-app",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@10.14.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:domain": "vitest run src/lib/data src/lib/workspaces src/lib/enterprise",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:platform": "pnpm test:integration",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.mjs",
    "db:status": "node --env-file-if-exists=.env scripts/db-status.mjs",
    "db:migrate:test": "node --env-file-if-exists=.env scripts/db-migrate.mjs --test",
    "db:status:test": "node --env-file-if-exists=.env scripts/db-status.mjs --test",
    "test:integration": "pnpm db:validate && pnpm test:migrations",
    "test:all": "pnpm test:domain && pnpm test:integration",
    "db:validate": "node scripts/db-validate.mjs",
    "test:migrations": "node --env-file-if-exists=.env scripts/test-migrations.mjs",
    "db:seed:dev": "tsx --env-file-if-exists=.env scripts/db-seed-dev.ts",
    "auth:bootstrap": "tsx --env-file-if-exists=.env scripts/auth-bootstrap.ts",
    "db:seed:platform": "tsx --env-file-if-exists=.env scripts/db-seed-platform.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "mysql2": "^3.24.4",
    "better-auth": "^1.7.5"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^22.10.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "tsx": "^4.20.6"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
